{
  "name": "finanzplaner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "export:check": "tsx scripts/export-check.ts",
    "export:berichte": "tsx scripts/export-berichte.ts",
    "export:pdf": "tsx --tsconfig tsconfig.scripts.json scripts/export-pdf.ts",
    "export:excel": "tsx --tsconfig tsconfig.scripts.json scripts/export-excel.ts",
    "excel:abgleich": "tsx --tsconfig tsconfig.scripts.json scripts/excel-abgleich.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-virtual": "^3.14.26",
    "exceljs": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "description": "Finanzplaner für Existenzgründer – Datenmodell und Rechenkern",
  "engines": {
    "node": ">=22"
  }
}
